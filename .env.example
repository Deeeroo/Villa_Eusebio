# Copy this file to .env, then put your real Gmail App Password there.
# Never commit .env or share the app password in chat.

APP_URL=http://localhost/capstone_system

ADMIN_EMAIL=owner@example.com

MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=botvillaeusebio@gmail.com
SMTP_PASSWORD=paste_your_16_character_google_app_password_here
SMTP_FROM_EMAIL=botvillaeusebio@gmail.com
SMTP_FROM_NAME="Villa Eusebio"
SMTP_TIMEOUT=20

# Optional OCR for payment proof screenshots.
# Install Tesseract OCR on the server, then point this to the executable.
# Windows/XAMPP example:
TESSERACT_PATH="C:\Program Files\Tesseract-OCR\tesseract.exe"
